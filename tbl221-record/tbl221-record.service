[Unit]
Description=TBL221 Linux Sistem Kaynakları İzleme Hizmeti
Documentation=file:/opt/tbl221-record/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tbl221-record/main.py --config /etc/tbl221-record.toml
Restart=on-failure
RestartSec=5s
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tbl221-record
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tbl221-record

[Install]
WantedBy=multi-user.target
